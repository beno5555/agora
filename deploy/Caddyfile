# Caddy: HTTPS for the public host, with a Let's Encrypt certificate it gets and renews by itself,
# forwarding everything to the app on localhost:8080. setup-server.sh fills in the host
# (e.g. 203-0-113-5.sslip.io; the placeholder on the next line) and installs this as /etc/caddy/Caddyfile.
AGORA_HOST {
	reverse_proxy localhost:8080
}
